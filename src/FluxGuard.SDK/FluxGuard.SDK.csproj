<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FluxGuard.SDK</PackageId>
    <Description>FluxGuard SDK - ASP.NET Core middleware and Microsoft.Extensions.AI integration for LLM protection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxGuard\FluxGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The shared framework, not the Microsoft.AspNetCore.Http 2.x package. That package is a
      re-release of the previous generation: taking it alongside a host that already carries
      Microsoft.AspNetCore.App means the same types can resolve from two places, and the two are
      serviced on separate schedules.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Extensions.Logging.Abstractions and Microsoft.Extensions.Options are not listed:
      the shared framework above already carries them, and NuGet reports pinning them as redundant
      (NU1510).
    -->
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

</Project>
