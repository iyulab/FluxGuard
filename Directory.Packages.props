<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <!-- ASP.NET Core -->
    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <!-- coverlet.MTP: direct MTP-native successor to coverlet.collector (same project, same
         versioning line) — kept over Microsoft.Testing.Extensions.CodeCoverage to stay on the
         open-source tool this ecosystem already standardized on, not switch to a closed-source-
         free-to-use one. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <!-- Compiles the README's C# blocks (ReadmeSnippetCompileTests) -->
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
    <!-- Benchmarks -->
  </ItemGroup>
</Project>