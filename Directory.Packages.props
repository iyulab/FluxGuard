<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <!-- ML/ONNX -->
    <!-- Deliberately not "latest patch": NuGet's highest-floor-wins resolution means this
         package's own floor becomes the effective floor for every consumer that shares ORT
         in their graph, even ones with no use for anything past this version. Pinned to
         1.24.4, matching modules/lm-supply's own re-pin (ORT 1.26.0 has a DirectML
         LayerNorm/QDQ-scale crash lm-supply worked around by dropping back), and this
         package's own L2/ML layer (OnnxSessionManager, SessionOptionsFactory,
         L2PromptInjectionGuard, L2ToxicityGuard) uses only baseline ORT API (InferenceSession,
         SessionOptions, Tensors) with no 1.25/1.26-specific surface. See docket
         iyulab/FluxGuard#156. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.3.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform — BD-20260829-xunit-v3-pilot rollout) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <!-- coverlet.MTP: direct MTP-native successor to coverlet.collector (same project, same
         versioning line) — kept over Microsoft.Testing.Extensions.CodeCoverage to stay on the
         open-source tool this ecosystem already standardized on, not switch to a closed-source-
         free-to-use one. -->
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
</Project>